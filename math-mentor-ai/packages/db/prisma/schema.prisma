generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  PARENT
  CHILD
}

enum PlanTier {
  FREE
  BASIC
  PREMIUM
  FAMILY
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  UNIVERSITY
}

model User {
  id            String        @id @default(cuid())
  auth0Sub      String        @unique
  email         String?       @unique
  accountType   AccountType
  displayName   String
  dateOfBirth   DateTime?
  parentId      String?
  parent        User?         @relation("ParentChildren", fields: [parentId], references: [id])
  children      User[]        @relation("ParentChildren")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  profile       Profile?
  subscription  Subscription?
  attempts      Attempt[]
  progress      Progress[]
  roles         Role[]
}

model Role {
  id      String @id @default(cuid())
  name    String @unique // e.g., ADMIN
  users   User[]
}

model Profile {
  id            String  @id @default(cuid())
  user          User    @relation(fields: [userId], references: [id])
  userId        String  @unique
  gradeLevel    Int?
  country       String?
  timezone      String?
  preferences   Json?
}

model Subscription {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @unique
  plan           PlanTier
  provider       String   // stripe | mpesa
  providerRef    String?  // subscription id
  currency       String   @default("USD")
  status         String   @default("active")
  validUntil     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LessonTopic {
  id            String      @id @default(cuid())
  title         String
  gradeMin      Int
  gradeMax      Int
  difficulty    Difficulty
  description   String
  content       Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  attempts      Attempt[]
  progresses    Progress[]
}

model Progress {
  id           String       @id @default(cuid())
  user         User         @relation(fields: [userId], references: [id])
  userId       String
  topic        LessonTopic  @relation(fields: [topicId], references: [id])
  topicId      String
  masteryScore Int          @default(0)
  streak       Int          @default(0)
  updatedAt    DateTime     @updatedAt
  createdAt    DateTime     @default(now())
}

model Attempt {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id])
  userId       String
  input        String
  result       String
  correct      Boolean
  score        Int         @default(0)
  topic        LessonTopic? @relation(fields: [topicId], references: [id])
  topicId      String?
  createdAt    DateTime    @default(now())
}